<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Wedding Invitation | Shree Digital Studio</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Georgia,serif;
  background:#080808;
  color:#fff;
  text-align:center;
  overflow-x:hidden;
}

.hero{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:30px 15px;
  position:relative;
  background:
    radial-gradient(circle at center,#3b2a08 0%,#100d07 35%,#050505 75%);
}

.card{
  width:100%;
  max-width:900px;
  padding:55px 25px;
  border:1px solid #d6ad45;
  border-radius:25px;
  box-shadow:0 0 50px rgba(214,173,69,.25);
  position:relative;
  overflow:hidden;
}

.small{
  color:#d6ad45;
  letter-spacing:5px;
  font-size:14px;
  text-transform:uppercase;
}

h1{
  margin-top:25px;
  font-size:60px;
  color:#e8c66a;
  text-shadow:0 0 20px rgba(232,198,106,.35);
}

.names{
  font-size:38px;
  margin:20px 0;
  color:#fff;
}

.and{
  color:#d6ad45;
  font-size:25px;
}

.photo{
  width:260px;
  height:260px;
  border-radius:50%;
  object-fit:cover;
  border:5px solid #d6ad45;
  padding:6px;
  margin:25px auto;
  display:block;
  background:#111;
  box-shadow:0 0 35px rgba(214,173,69,.35);
}

.details{
  margin:30px auto;
  max-width:650px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.box{
  padding:20px 10px;
  border:1px solid #5e4a20;
  border-radius:15px;
  background:rgba(255,255,255,.03);
}

.box b{
  display:block;
  color:#d6ad45;
  font-size:13px;
  margin-bottom:8px;
  letter-spacing:1px;
}

.box span{
  font-size:17px;
}

.message{
  margin:30px auto;
  max-width:650px;
  line-height:1.8;
  color:#ddd;
}

.rsvp{
  display:inline-block;
  margin-top:20px;
  padding:15px 30px;
  border-radius:50px;
  background:#d6ad45;
  color:#111;
  text-decoration:none;
  font-weight:bold;
  transition:.3s;
}

.rsvp:hover{
  transform:scale(1.05);
  box-shadow:0 0 25px rgba(214,173,69,.5);
}

.footer{
  margin-top:35px;
  color:#d6ad45;
  font-size:14px;
}

/* Golden particles */
.particle{
  position:absolute;
  width:4px;
  height:4px;
  background:#e8c66a;
  border-radius:50%;
  animation:float 7s linear infinite;
  opacity:.7;
}

@keyframes float{
  0%{
    transform:translateY(100vh);
    opacity:0;
  }
  20%{opacity:.8;}
  100%{
    transform:translateY(-20vh);
    opacity:0;
  }
}

@media(max-width:650px){
  h1{
    font-size:42px;
  }

  .names{
    font-size:28px;
  }

  .photo{
    width:210px;
    height:210px;
  }

  .details{
    grid-template-columns:1fr;
  }

  .card{
    padding:40px 18px;
  }
}
</style>
</head>

<body>

<section class="hero">

  <div class="particle" style="left:10%;animation-delay:0s"></div>
  <div class="particle" style="left:25%;animation-delay:2s"></div>
  <div class="particle" style="left:40%;animation-delay:4s"></div>
  <div class="particle" style="left:60%;animation-delay:1s"></div>
  <div class="particle" style="left:75%;animation-delay:3s"></div>
  <div class="particle" style="left:90%;animation-delay:5s"></div>

  <div class="card">

    <div class="small">Together With Their Families</div>

    <h1>Wedding Invitation</h1>

    <!-- PHOTO -->
    <img
      class="photo"
      src="01.jpg"
      alt="Bride and Groom"
    >

    <!-- NAMES -->
    <div class="names">
      Rahul
      <div class="and">&amp;</div>
      Priya
    </div>

    <p class="message">
      With immense joy and happiness, we invite you to
      celebrate the beginning of our beautiful journey together.
      Your presence will make our special day even more memorable.
    </p>

    <!-- DETAILS -->
    <div class="details">

      <div class="box">
        <b>DATE</b>
        <span>15 December 2026</span>
      </div>

      <div class="box">
        <b>TIME</b>
        <span>07:00 PM</span>
      </div>

      <div class="box">
        <b>VENUE</b>
        <span>Royal Wedding Palace, Kanpur</span>
      </div>

    </div>

    <!-- WHATSAPP -->
    <a
      class="rsvp"
      href="https://wa.me/916392926855?text=Hello%2C%20I%20would%20like%20to%20confirm%20my%20presence%20at%20the%20wedding."
      target="_blank"
    >
      💬 RSVP on WhatsApp
    </a>

    <div class="footer">
      With Love ❤️ | Shree Digital Studio
    </div>

  </div>

</section>

</body>
</html>
